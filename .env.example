# Configuratie voor de Octoplant plugin

# De volledige basis-URL van de Octoplant-server,
# inclusief https:// en eventuele poort
OCTOPLANT_SERVER=

# Volledig lokaal pad naar de clientarchive voor VDogAutoCheckOut.exe,
# bijvoorbeeld: C:\vdClientArchive
OCTOPLANT_CLIENT_ARCHIVE_PATH=C:\vdClientArchive

# Optioneel: volledig pad naar een Python 3.11+-runtime met server-dependencies.
# Zonder deze override kiest de launcher achtereenvolgens .venv, py -3 en python.
OCTOPLANT_PYTHON_PATH=

# Windows Generic Credential-target: "Octoplant" (vast in de wrapper).
# Sla gebruikersnaam en wachtwoord nooit in dit bestand op.
