# Octoplant -- OctoPlant/versiondog configuratie
# Kopieer dit bestand naar .env en pas de waarden aan.
#
# Gebruikersnaam en wachtwoord staan NIET in dit bestand.
# Ze worden intern beheerd door VDogCheckOut.exe.
# Het .env bestand mag NOOIT worden ingecheckt in versiebeheer.
#
# Paden mogen Windows-omgevingsvariabelen bevatten (%LOCALAPPDATA%, %APPDATA%, ...)
# die automatisch worden uitgebreid naar de juiste locatie op elk toestel.

# OctoPlant server URL (inclusief poort 64023)
OCTOPLANT_SERVER=https://your-octoplant-server:64023

# AD-domein (optioneel)
OCTOPLANT_DOMAIN=YOUR-AD-DOMAIN

# Volledig pad naar de lokale client archive map
OCTOPLANT_ARCHIVE_PATH=D:\vdClientArchive

# Optioneel: pad naar de vdogClient installatie (map met VDogAutoCheckOut.exe, etc.)
# Laat leeg om auto-discover te gebruiken (exe-map, standaard installatiemap, PATH)
OCTOPLANT_VDOG_CLIENT_PATH=

# SSL-certificaat verificatie
# false = self-signed certificaten toestaan (OctoPlant gebruikt vaak self-signed)
OCTOPLANT_SSL_VERIFY=false

# Uitvoermap voor gedownloade export-bestanden (ZIP)
# Laat leeg om de systeem temp-map te gebruiken
OCTOPLANT_EXPORT_PATH=

# Doelmap voor checkout-bewerkingen
# Laat leeg om de standaard {projectroot}\octoPlantCheckouts te gebruiken
OCTOPLANT_CHECKOUT_PATH=

# Pad naar de access-rights database (optioneel, auto-discover indien leeg)
# Portable standaard: %LOCALAPPDATA%\Octoplant\access-rights.db
ACCESS_RIGHTS_DB_PATH=%LOCALAPPDATA%\Octoplant\access-rights.db