{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ot-engineer.local/contracts/work-result.schema.json",
  "title": "OT work result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "correlation_id", "step_id", "status", "output_artifacts", "evidence", "risks"],
  "properties": {
    "schema_version": { "const": "1.2" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "step_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "blocked", "needs_input", "failed", "unsafe", "ambiguous"] },
    "summary": { "type": "string" },
    "output_artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "dependency_inventory": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "imported_dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "unresolvedDependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/unresolvedDependency" }
    },
    "placeholder_risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/placeholderRisk" }
    },
    "octoplant_checkout": { "$ref": "#/$defs/octoplantCheckout" },
    "start_project": { "$ref": "#/$defs/artifact" },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "risks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/risk" } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "local_path"],
      "properties": {
        "ref": { "type": "string" },
        "kind": { "type": "string" },
        "local_path": { "type": "string" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dfb_name"],
      "properties": {
        "dfb_name": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 },
        "version_number": { "type": "string", "minLength": 1 },
        "present_in_project": { "type": "boolean" }
      }
    },
    "unresolvedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dfb_name", "reason"],
      "properties": {
        "dfb_name": { "type": "string", "minLength": 1 },
        "version_hint": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "placeholderRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag_number", "function", "risk"],
      "properties": {
        "tag_number": { "type": "string", "minLength": 1 },
        "function": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "minLength": 1 }
      }
    },
    "octoplantCheckout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkout_executed": { "type": "boolean" },
        "resolved_identity": { "$ref": "#/$defs/projectIdentity" },
        "resolved_project_identity": { "type": "string", "minLength": 1 },
        "component_path": { "type": "string", "minLength": 1 },
        "local_checkout_ref": { "type": ["string", "null"], "minLength": 1 },
        "source_version": { "type": ["string", "number", "null"] },
        "ambiguity": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "projectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installation_name", "plc_name", "project_folder"],
      "properties": {
        "installation_name": { "type": "string", "minLength": 1 },
        "installation_folder": { "type": "string", "minLength": 1 },
        "plc_name": { "type": "string", "minLength": 1 },
        "project_folder": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["captured_at"],
      "anyOf": [
        { "required": ["kind", "value"] },
        { "required": ["type"] }
      ],
      "properties": {
        "kind": { "type": "string" },
        "type": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" },
        "value": {}
      }
    },
    "risk": {
      "anyOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "description"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "returncode": { "type": "integer" },
        "message": { "type": "string" }
      }
    }
  }
}
