<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>VDogCheckIn</AssemblyName>
    <RootNamespace>VDogCheckIn</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <TrimSelf>false</TrimSelf>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\VDogCheckOut\Config.cs" Link="Config.cs" />
    <Compile Include="..\VDogCheckOut\CredentialsManagerClient.cs" Link="CredentialsManagerClient.cs" />
  </ItemGroup>
</Project>
